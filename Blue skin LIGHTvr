.freeforms .tag {
  --button-background: #bdeff6;
  --bg-dark: #bdeff6;
  --button-foreground: #d5fafa;
  background-color: #bdeff6;
  background: var(--bottom-glow), linear-gradient(to bottom, #729fd8, #bdeff6);
  box-shadow: 0 4px 4px rgba(0, 0, 0, 0.4);
