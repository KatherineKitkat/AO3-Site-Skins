  border-radius: 9999px;
  cursor: pointer;
  margin: 0.25em 0.5em 0.25em 0;
  padding: 0.3em 0.8em;
  font-size: 0.75rem;
  position: relative;
  text-shadow: 0 2px .5em #013461;
  transition: all 300ms;
  color: #013461;
  font-family: "Segoe UI Semilight", Tahoma, Geneva, Verdana, sans-serif, Arial, Helvetica, sans-serif;
  font-weight: 700;
